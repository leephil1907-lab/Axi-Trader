generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String?
  name        String
  firstName   String?
  lastName    String?
  phone       String?
  country     String?
  language    String   @default("en")
  currency    String   @default("USD")
  accountType String   @default("standard")
  platform    String   @default("mt5")
  role        String   @default("user")
  status      String   @default("active")
  kycStatus   String   @default("not_started")
  balance     Float    @default(0)
  equity      Float    @default(0)
  margin      Float    @default(0)
  freeMargin  Float    @default(0)
  marginLevel Float    @default(0)
  totalProfit Float    @default(0)
  totalLoss   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLogin   DateTime?

  transactions Transaction[]
  trades       Trade[]
  kycDocs      KycDocument[]
  promotions   PromotionEnrollment[]
  bonusLedger  BonusLedger[]
  auditLogs    AuditLog[]
  passwordResets PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Transaction {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  type                  String
  amount                Float
  currency              String
  method                String
  paymentReference      String?
  paymentDetails        String?
  status                String                 @default("pending")
  promotionEnrollmentId String?
  promotionEnrollment   PromotionEnrollment?  @relation(fields: [promotionEnrollmentId], references: [id])
  createdAt             DateTime               @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
  rejectionReason       String?
  bonusLedger           BonusLedger?

  @@index([userId, status])
  @@index([promotionEnrollmentId])
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  symbol       String
  type         String
  volume       Float
  openPrice    Float
  currentPrice Float
  profit       Float
  stopLoss     Float?
  takeProfit   Float?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
}

model KycDocument {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  status          String   @default("pending")
  fileUrl         String
  fileName        String
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
}

model Promotion {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  description          String
  bonusPercent         Float    @default(100)
  minDeposit           Float    @default(0)
  maxBonus             Float?
  currency             String   @default("USD")
  eligibleCountries    String?
  eligibleAccountTypes String?
  firstDepositOnly     Boolean  @default(false)
  requiresTrade        Boolean  @default(false)
  active               Boolean  @default(false)
  startsAt             DateTime
  endsAt               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  enrollments PromotionEnrollment[]
  bonusLedger BonusLedger[]

  @@index([active, startsAt, endsAt])
}

model PromotionEnrollment {
  id                   String    @id @default(cuid())
  userId               String
  promotionId          String
  status               String    @default("active")
  activatedAt          DateTime  @default(now())
  expiresAt            DateTime?
  qualifyingDepositId  String?
  completedAt          DateTime?
  user                 User      @relation(fields: [userId], references: [id])
  promotion            Promotion @relation(fields: [promotionId], references: [id])
  transactions         Transaction[]
  bonusLedger          BonusLedger[]

  @@unique([userId, promotionId])
  @@index([userId, status])
  @@index([promotionId, status])
}

model BonusLedger {
  id            String                @id @default(cuid())
  userId        String
  promotionId   String
  enrollmentId  String
  transactionId String?               @unique
  type          String                @default("credit")
  status        String                @default("credited")
  amount        Float
  currency      String
  description   String
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id])
  promotion     Promotion             @relation(fields: [promotionId], references: [id])
  enrollment    PromotionEnrollment  @relation(fields: [enrollmentId], references: [id])
  transaction   Transaction?          @relation(fields: [transactionId], references: [id])

  @@index([userId, createdAt])
  @@index([promotionId, status])
}

model FundingMethod {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  type            String
  enabled         Boolean  @default(false)
  countries       String?
  currencies      String?
  minAmount       Float?
  maxAmount       Float?
  instructions    String?
  asset           String?
  network         String?
  walletAddress   String?
  bankName        String?
  bankAccountName String?
  bankAccount     String?
  bankRouting     String?
  bankSwift       String?
  payeeName       String?
  payeeAccount    String?
  stripeEnabled   Boolean  @default(false)
  stripePublicKey String?
  logoUrl         String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  actor      User?    @relation(fields: [actorUserId], references: [id])
  action     String
  resource   String
  resourceId String?
  outcome    String   @default("success")
  ipAddress  String?
  userAgent  String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([requestId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}
