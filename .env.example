# Axi Trader production environment template
# Copy to .env for local dev, or set each value in the Deno Deploy dashboard
# (Project → Settings → Environment Variables).

DATABASE_URL="postgresql://user:password@host:5432/axi_trader?schema=public"
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN="7d"

# Email (Resend — domain already verified)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="AxiTrades <no-reply@axitrades.com>"

# Admin notifications (new funding/withdrawal requests + Stripe payments land here)
ADMIN_NOTIFICATION_EMAIL="no-reply@axitrades.com"

# Payments (Stripe — card processor; funds settle into your Stripe balance.
# Users are NEVER credited automatically: approve each payment in /admin.)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# (Admin notification recipient is set near the top of this file.)

# Live market data (OPTIONAL — built-in Yahoo Finance aggregation is used when unset).
# Set to override with your own provider endpoint returning JSON quotes.
MARKET_DATA_URL=""
# Optional comma-separated allow-list of platform symbols (default: full universe).
MARKET_SYMBOLS=""

# Chat assistant (OPTIONAL — widget shows an honest fallback when unset).
GROQ_API_KEY=""

# Real broker execution adapter. Leave unset until an actual broker gateway is integrated.
BROKER_EXECUTION_URL=""
BROKER_API_KEY=""
BROKER_API_SECRET=""

# KYC provider
KYC_PROVIDER=""
KYC_API_KEY=""
KYC_SECRET_KEY=""

# Production domain. Stripe checkout success/cancel URLs and email links are
# built from this — it MUST be the live site, or payments return to the wrong URL.
# Register this exact webhook endpoint in Stripe Dashboard → Developers → Webhooks
# for the `checkout.session.completed` event:
#   https://www.axitrades.com/api/payments/stripe/webhook/
NEXT_PUBLIC_APP_URL="https://www.axitrades.com"
API_URL="https://www.axitrades.com/api"
