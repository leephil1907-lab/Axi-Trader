# Axi Trader production environment template

DATABASE_URL="postgresql://user:password@host:5432/axi_trader?schema=public"
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN="7d"

# Email
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Axi <noreply@your-domain.com>"

# Payments
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Live market data provider endpoint. Do not commit provider credentials.
MARKET_DATA_URL="https://your-market-provider.example/api/quotes"

# Real broker execution adapter. Leave unset until an actual broker gateway is integrated.
BROKER_EXECUTION_URL=""
BROKER_API_KEY=""
BROKER_API_SECRET=""

# KYC provider
KYC_PROVIDER=""
KYC_API_KEY=""
KYC_SECRET_KEY=""

NEXT_PUBLIC_APP_URL="https://axitrades.com"
API_URL="https://axitrades.com/api"
